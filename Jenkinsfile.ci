pipeline {
    agent any

    environment {
        BACKEND_DIR = './backend'
        FRONTEND_DIR = './frontend'
        TESTCONTAINERS_RYUK_DISABLED = 'true'
        SONAR_URL = "http://j14b207.p.ssafy.io:9000"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                echo "🔍 CI Check for: ${env.GIT_BRANCH}"
            }
        }

        stage('Frontend CI') {
            agent {
                docker { image 'node:20-alpine' }
            }
            steps {
                dir("${FRONTEND_DIR}") {
                    sh 'npm ci'
                    sh 'npm run build'
                }
            }
        }

        stage('Backend CI & Test & SonarQube') {
            agent {
                docker {
                    image 'gradle:8-jdk17'
                    args '-u root:root -v /var/run/docker.sock:/var/run/docker.sock --add-host=host.docker.internal:host-gateway'
                }
            }
            environment {
                DOCKER_HOST = 'unix:///var/run/docker.sock'
                TESTCONTAINERS_HOST_OVERRIDE = 'host.docker.internal'
            }
            steps {
                dir("${BACKEND_DIR}") {
                    sh 'chmod +x ./gradlew'
                    withSonarQubeEnv('sonar-server') {
                        sh './gradlew clean build jacocoTestReport sonar --info' 
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def sonarUrl = "${env.SONAR_URL}/dashboard?id=al-maeng-backend"

                def mmMessage = "🧪 **[CI 결과] ${env.JOB_NAME}**\n" +
                                "**브랜치**: ${env.GIT_BRANCH}\n" +
                                "**결과**: ${currentBuild.result ?: 'SUCCESS'}\n" +
                                "📊 [SonarQube 리포트 확인](${sonarUrl})\n" +
                                "🔗 [상세 로그](${env.BUILD_URL})"
                mattermostSend(color: (currentBuild.result == 'SUCCESS' ? 'good' : 'danger'), message: mmMessage)
            }
        }

        cleanup {
            cleanWs()
        }
    }
}